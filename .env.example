# Twitter API Configuration
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_bearer_token
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_default_chat_id

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_alerts
DB_HOST=localhost
DB_PORT=5432
DB_USER=crypto_user
DB_PASSWORD=crypto_password
DB_NAME=crypto_alerts

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
ADMIN_EMAIL=admin@example.com

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# Alert Configuration
ALERT_CHECK_INTERVAL=300000
DIGEST_INTERVAL=3600000
KEYWORDS_TESTNET=testnet,test network,beta launch,launch on testnet
KEYWORDS_NFT=nft,nft collection,nft drop,nft project,nft marketplace
KEYWORDS_FUNDING=funding round,series a,series b,series c,seed round,investment,raised

# Monitoring Configuration
TWITTER_SEARCH_KEYWORDS=crypto testnet NFT launch funding round web3
TWITTER_FILTER_KEYWORDS=-test -scam -fake
TWITTER_MONITOR_INTERVAL=300000

# Feature Flags
ENABLE_TWITTER=true
ENABLE_TELEGRAM=true
ENABLE_EMAIL=true
ENABLE_DASHBOARD=true
ENABLE_NLP_DETECTION=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
